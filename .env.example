# Server Configuration
PORT=3000
NODE_ENV=production

# Base Public URL (e.g. https://your-app.up.railway.app or https://clip-clipflow-studio.onrender.com)
APP_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipflow_db?schema=public

# Redis Connection (for BullMQ queues)
REDIS_URL=redis://127.0.0.1:6379

# 32-character secret key for encrypting user access tokens in database
TOKEN_ENCRYPTION_KEY=your_secret_32_character_token_key_here

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: Auto-derived from APP_URL if left empty:
# GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/api/auth/youtube/callback

# YouTube Data API v3 Key (for video metadata & transcript fallback)
YOUTUBE_API_KEY=your_youtube_api_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# 🚀 YOUTUBE CLOUD DOWNLOADER CONFIGURATION (Render / Railway Datacenter Bypass)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Primary Strategy: Residential / Mobile Proxy Routing ──
# YouTube blocks datacenter IPs (Render/AWS/GCP). Routing yt-dlp traffic through a
# residential proxy completely bypasses this block when combined with Android client spoofing.
# Supported formats: http://username:password@host:port or socks5://username:password@host:port
# Providers: BrightData, Webshare, Smartproxy, IPRoyal, Oxylabs, Rayobyte
# YTDLP_PROXY=http://user123:pass456@residential-proxy.example.com:8080

# ── Secondary Strategy: Serverless / 3rd-Party Extraction API Fallback ──
# If yt-dlp fails or memory/CPU limits are reached on cloud servers, this fallback requests
# the direct progressive MP4 stream link from an external API and streams it directly to disk.

# Option A: RapidAPI YouTube Downloader
# Obtain a key from https://rapidapi.com/ (e.g. ytstream-download-youtube-videos or similar)
# RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_HOST=ytstream-download-youtube-videos.p.rapidapi.com
# RAPIDAPI_URL=https://ytstream-download-youtube-videos.p.rapidapi.com/dl?id=

# Option B: Cobalt API (Open-Source Video Downloader Instance)
# Public instance: https://api.cobalt.tools/ or your own self-hosted Cobalt Docker container
# COBALT_API_URL=https://api.cobalt.tools/
# COBALT_API_KEY=optional_bearer_token

# Option C: Custom Webhook / Serverless Edge Extractor (Cloudflare Worker / AWS Lambda)
# CUSTOM_YOUTUBE_API_URL=https://my-worker.example.workers.dev/download

# ── Authentication & Token Bypass Options ──
# Modern YouTube PO-Token (Proof of Origin) and Visitor Data (optional alternative to cookies)
# YTDLP_PO_TOKEN=
# YTDLP_VISITOR_DATA=
# YTDLP_OAUTH2=false

# Optional: YouTube Cookies in Netscape or base64 format (for cloud hosts like Render)
# Alternatively, add cookies.txt as a Render Secret File at /etc/secrets/cookies.txt
# YOUTUBE_COOKIES=

# ═══════════════════════════════════════════════════════════════════════════════

# Meta / Instagram OAuth
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
# Optional: Auto-derived from APP_URL if left empty:
# INSTAGRAM_REDIRECT_URI=https://your-app.up.railway.app/api/auth/instagram/callback
INSTAGRAM_GRAPH_BASE_URL=https://graph.facebook.com/v23.0

# Cloudinary Cloud Storage (for video hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Whisper Model (tiny, base, small, medium)
WHISPER_MODEL=base
